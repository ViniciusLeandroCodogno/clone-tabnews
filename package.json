{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Estudo para criar um projeto de programação do zero direcionado pelo Filipe Deschamps do https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "lint:eslint:check": "eslint .",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "18.0.8",
    "dotenv-expand": "1000.0.0",
    "next": "16.4.1",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "commitizen": "4.3.2",
    "concurrently": "10.0.6",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "typescript": "5.9"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
